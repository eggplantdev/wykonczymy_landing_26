# --- the container on 5436 (docker compose up -d). The psql client the db:* scripts shell
#     into, a restore target for db:import, and the database `pnpm test` runs against — the
#     suites create and delete rows, so they refuse to start unless TEST_POSTGRES_URL names a
#     host that is not production. Point it anywhere that isn't; the container is just what
#     this machine already has. Refresh its contents with `pnpm test:db:refresh`. ---
POSTGRES_DB=landing26
POSTGRES_USER=landing26
POSTGRES_PASSWORD=landing26
DOCKER_CONTAINER=landing26-cms
TEST_POSTGRES_URL=postgresql://landing26:landing26@localhost:5436/landing26

# --- the database the app reads, on Vercel and on your laptop alike: production (Neon).
#     Both keys hold the same URL; PROD_POSTGRES_URL stays separate so the scripts that
#     dump, restore and migrate name production out loud. ---
POSTGRES_URL=
PROD_POSTGRES_URL=


PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- media (Vercel Blob). The production store — uploads made in dev land there too. ---
BLOB_READ_WRITE_TOKEN=

# --- email (nodemailer / SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- lead delivery into the leads app (yolo/wykonczymy) ---
LEADS_INTAKE_URL=
LEADS_INTAKE_SECRET=
